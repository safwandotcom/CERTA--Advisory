NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when running `npm run seed:admin` locally (and for the e2e suite,
# which signs in as this account) — NOT needed in Vercel.
SEED_ADMIN_EMPLOYEE_ID=
SEED_ADMIN_PASSWORD=
# Optional, defaults to "Admin".
SEED_ADMIN_NAME=

# Password recovery email (see docs/superpowers/specs/2026-09-12-portal-forgot-password-design.md).
# Requires a verified sending domain in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=
